{
  "phase1Create": {
    "commonOption": {
      "elements": [
        {
          "id": "sales-chart",
          "type": "chart",
          "position": { "x": 0, "y": 0, "width": 640, "height": 360 },
          "options": {
            "chartType": "bar",
            "data": {
              "type": "standard",
              "value": {
                "columns": ["月份", "产品A", "产品B"],
                "rows": ["1月", "2月"],
                "data": [
                  { "月份": "1月", "产品A": 120, "产品B": 90 },
                  { "月份": "2月", "产品A": 140, "产品B": 110 }
                ]
              }
            },
            "config": {
              "mappingSpec": { "x": "月份", "y": ["产品A", "产品B"] },
              "barLink": { "enable": true },
              "modelSpec": [
                { "specKey": "series", "target": { "measure": "产品A" }, "spec": { "seriesLabel": { "visible": true } } },
                { "specKey": "series", "target": { "measure": "产品B" }, "spec": { "seriesLabel": { "visible": true } } }
              ]
            }
          }
        }
      ]
    }
  },
  "phase2AfterReadback": {
    "precondition": "仅当宿主不支持语义 target 时使用。示例假设 browserData/runtime readback 返回 id=series-runtime-id、specIndex=0；实际执行必须分别替换两个系列的真实值",
    "modelSpecPatch": [
      { "id": "产品A-readback-id", "specKey": "series", "specIndex": 0, "spec": { "seriesLabel": { "visible": true } } },
      { "id": "产品B-readback-id", "specKey": "series", "specIndex": 1, "spec": { "seriesLabel": { "visible": true } } }
    ],
    "mergeRule": "按真实 identity 深合并到已有 modelSpec，保留 axes/title/legend/其他 series；不要替换整个数组。"
  },
  "note": "支持语义 target 的宿主可在首次 commonOption 同时开启 barLink 和两个系列标签；不支持时先创建、readback，再按两个真实 identity 分别补 modelSpec。"
}
