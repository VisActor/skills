{
  "name": "vbi-dashboard-runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:unit:coverage": "node --experimental-test-coverage --test-coverage-include='**/runtime/*.mjs' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test test/database.test.mjs test/server.test.mjs test/source.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='**/runtime/*.mjs' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test test/*.test.mjs"
  },
  "dependencies": {
    "mysql2": "3.15.3",
    "@visactor/vquery": "0.7.0"
  }
}
